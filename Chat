async function addServer(code,name){
  var initialMessages={};TEXT_CHANNELS.forEach(function(channel){initialMessages[channel.name]=[];});
  var srv={code:code,name:name,ch:'general',
    ms:initialMessages,
    mem:{},vc:null,banned:{},unread:{},newTs:{},newDividerPending:{}};
  S.servers.push(srv);
  S.si=S.servers.length-1;
  renderSrvIcons();renderChannels();
  addSys('general','Welcome to #general! Share server code "'+code+'" with friends.');
  addSys('general','Type /auth <rank> <password> to authenticate as staff.');
  render();updMem();
  if(pn){
    pn.subscribe({channels:srvChannels(code)});
    pub(scp(code,'sys'),{t:'join',uid:S.uid,u:S.u,ac:S.ac,nc:S.nc,bio:S.bio||'',pic:S.customPic||null,banner:S.banner||null,vc:null,mod:_mod.isMod(),tmod:_mod.isTmod(),dev:_mod.isOwner(),modHash:'',devHash:'',v:CLIENT_VERSION});
    pub(scp(code,'sys'),{t:'rollcall',uid:S.uid});
  }
  saveJoinedServers();
}

