// Convert decorative UI emoji to inline SVGs; preserve emoji in user messages/previews.
var uiEmojiPattern=/(?:\p{Regional_Indicator}{2}|[0-9#*]\uFE0F?\u20E3|\p{Extended_Pictographic}(?:\uFE0F|\uFE0E)?(?:\p{Emoji_Modifier})?(?:\u200D\p{Extended_Pictographic}(?:\uFE0F|\uFE0E)?(?:\p{Emoji_Modifier})?)*)/gu;
function svgifyUiEmoji(root){
  var skip='script,style,textarea,input,.mg,.msg-toast-text,.emoji-picker,svg.ui-emoji,svg.emoji-svg';
  if(root.nodeType===Node.ELEMENT_NODE&&root.closest(skip))return;
  var nodes=[],node;
  if(root.nodeType===Node.TEXT_NODE){node=root;if(node.parentElement&&!node.parentElement.closest(skip)&&uiEmojiPattern.test(node.nodeValue))nodes.push(node);uiEmojiPattern.lastIndex=0;}
  else{
    var walker=document.createTreeWalker(root,NodeFilter.SHOW_TEXT);
    while((node=walker.nextNode())){
      if(node.parentElement&&!node.parentElement.closest(skip)&&uiEmojiPattern.test(node.nodeValue))nodes.push(node);
      uiEmojiPattern.lastIndex=0;
    }
  }
  nodes.forEach(function(textNode){
    var text=textNode.nodeValue,fragment=document.createDocumentFragment(),last=0,match;
    uiEmojiPattern.lastIndex=0;
    while((match=uiEmojiPattern.exec(text))){
      fragment.appendChild(document.createTextNode(text.slice(last,match.index)));
      var svg=document.createElementNS('http://www.w3.org/2000/svg','svg');
      svg.setAttribute('class','ui-emoji');svg.setAttribute('viewBox','0 0 32 32');svg.setAttribute('role','img');svg.setAttribute('aria-label',match[0]);
      var glyph=document.createElementNS('http://www.w3.org/2000/svg','text');
      glyph.setAttribute('x','16');glyph.setAttribute('y','16');glyph.setAttribute('text-anchor','middle');glyph.setAttribute('dominant-baseline','central');glyph.setAttribute('font-size','25');glyph.setAttribute('font-family','Apple Color Emoji, Segoe UI Emoji, Noto Color Emoji, sans-serif');glyph.textContent=match[0];
      svg.appendChild(glyph);fragment.appendChild(svg);last=match.index+match[0].length;
    }
    fragment.appendChild(document.createTextNode(text.slice(last)));
    textNode.parentNode.replaceChild(fragment,textNode);
  });
}
svgifyUiEmoji(document.body);
new MutationObserver(function(records){records.forEach(function(record){record.addedNodes.forEach(function(node){if(node.nodeType===Node.ELEMENT_NODE||node.nodeType===Node.TEXT_NODE)svgifyUiEmoji(node);});});}).observe(document.body,{childList:true,subtree:true});

