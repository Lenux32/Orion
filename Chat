var voiceRecorder=null,voiceStream=null,voiceChunks=[],voiceCancelled=false,voiceTimer=null;
var voiceTargetSrv=null,voiceTargetChannel='';
var VOICE_MAX_SECONDS=8,VOICE_MAX_B64=24000;

async function toggleVoiceMessage(){
  if(!canPostToChannel(CS().ch)){addSys(CS().ch,'🔒 This channel is read-only.');render();return;}
  if(voiceRecorder&&voiceRecorder.state==='recording'){voiceRecorder.stop();return;}
  if(!navigator.mediaDevices||!navigator.mediaDevices.getUserMedia||!window.MediaRecorder){
    addSys(CS().ch,'Voice recording is not supported by this browser.');render();return;
  }
  if(_mute.get()){addSys(CS().ch,'You are muted and cannot send a voice message.');render();return;}
  voiceTargetSrv=CS();voiceTargetChannel=CS().ch;
  try{
    voiceStream=await navigator.mediaDevices.getUserMedia({audio:true});
    var opts={};
    if(MediaRecorder.isTypeSupported('audio/webm;codecs=opus'))opts.mimeType='audio/webm;codecs=opus';
    else if(MediaRecorder.isTypeSupported('audio/mp4'))opts.mimeType='audio/mp4';
    opts.audioBitsPerSecond=16000;
    voiceRecorder=new MediaRecorder(voiceStream,opts);
    voiceChunks=[];voiceCancelled=false;
    voiceRecorder.ondataavailable=function(e){if(e.data&&e.data.size)voiceChunks.push(e.data);};
    voiceRecorder.onstop=finishVoiceMessage;
    voiceRecorder.start();
    $('voiceStatus').classList.add('vis');$('voiceMsgBtn').classList.add('recording');
    $('voiceMsgBtn').title='Stop and send voice message';
    voiceTimer=setTimeout(function(){if(voiceRecorder&&voiceRecorder.state==='recording')voiceRecorder.stop();},VOICE_MAX_SECONDS*1000);
  }catch(e){
    stopVoiceTracks();
    addSys(CS().ch,'Could not access your microphone. Check browser microphone permissions.');render();
  }
}

function stopVoiceTracks(){
  if(voiceTimer){clearTimeout(voiceTimer);voiceTimer=null;}
  if(voiceStream){voiceStream.getTracks().forEach(function(t){t.stop();});voiceStream=null;}
  $('voiceStatus').classList.remove('vis');$('voiceMsgBtn').classList.remove('recording');
  $('voiceMsgBtn').title='Record voice message';
}

function cancelVoiceMessage(){
  voiceCancelled=true;
  if(voiceRecorder&&voiceRecorder.state==='recording')voiceRecorder.stop();
  else stopVoiceTracks();
}

function finishVoiceMessage(){
  stopVoiceTracks();
  if(voiceCancelled){voiceChunks=[];voiceRecorder=null;return;}
  var blob=new Blob(voiceChunks,{type:(voiceRecorder&&voiceRecorder.mimeType)||'audio/webm'});
  voiceChunks=[];voiceRecorder=null;
  if(!blob.size)return;
  if(Date.now()-S.lastSentTs<1000){addSys(CS().ch,'⏱ Slow down before sending another message.');render();return;}
  if(_mute.get()){addSys(CS().ch,'You are muted and cannot send a voice message.');render();return;}
  S.lastSentTs=Date.now();
  var reader=new FileReader();
  reader.onload=function(){
    var dataUrl=String(reader.result||''),parts=dataUrl.split(','),mime=blob.type.split(';')[0].toLowerCase();
    if(!/^audio\/(webm|ogg|mp4|wav)$/.test(mime)||parts.length<2||parts[1].length>VOICE_MAX_B64){
      addSys(CS().ch,'Voice message is too large to send. Try a shorter recording.');render();return;
    }
    var voice='data:'+mime+';base64,'+parts[1],ts=Date.now();
    var targetSrv=voiceTargetSrv||CS(),targetChannel=voiceTargetChannel||targetSrv.ch;
    if(!targetSrv.ms[targetChannel])targetSrv.ms[targetChannel]=[];
    var msg={t:'u',a:S.u,ac:S.ac,nc:S.nc,pic:S.customPic||null,x:'',img:null,voice:voice,fx:null,ts:ts,uid:S.uid,mod:_mod.isMod()};
    targetSrv.ms[targetChannel].push(msg);
    pub(scp(targetSrv.code,targetChannel),{t:'msg',u:S.u,ac:S.ac,nc:S.nc,pic:S.customPic||null,x:'',voice:voice,ts:ts,uid:S.uid,mod:_mod.isMod()});
    render();
  };
  reader.readAsDataURL(blob);
}

// ═══════ CHUNKED IMAGE SENDING ═══════
var CHUNK_SIZE=28000;
var pendingChunks={};

function sendImgChunked(ch,meta,imgData){
  var imgId=meta.uid+'-'+meta.ts;
  var total=Math.ceil(imgData.length/CHUNK_SIZE);
  pub(ch,{t:'img_meta',imgId:imgId,total:total,u:meta.u,ac:meta.ac,nc:meta.nc,x:meta.x,ts:meta.ts,uid:meta.uid,mod:!!meta.mod});
  for(var i=0;i<total;i++){
    (function(idx){
      setTimeout(function(){
        var chunk=imgData.substr(idx*CHUNK_SIZE,CHUNK_SIZE);
        pub(ch,{t:'img_chunk',imgId:imgId,idx:idx,data:chunk});
      },idx*80);
    })(i);
  }
}

function handleImgMeta(srv,cn,d){
  pendingChunks[d.imgId]={parts:new Array(d.total),received:0,total:d.total,meta:{u:d.u,ac:d.ac,nc:d.nc,x:d.x,ts:d.ts,uid:d.uid,mod:!!d.mod}};
  setTimeout(function(){delete pendingChunks[d.imgId]},30000);
}

function handleImgChunk(srv,cn,d){
  var pc=pendingChunks[d.imgId];if(!pc)return;
  if(pc.parts[d.idx])return;
  pc.parts[d.idx]=d.data;pc.received++;
  if(pc.received===pc.total){
    var imgData=pc.parts.join('');var m=pc.meta;
    if(!srv.ms[cn].some(function(msg){return msg.ts===m.ts&&msg.uid===m.uid})){
      srv.ms[cn].push({t:'u',a:m.u,ac:m.ac,nc:m.nc,x:m.x,img:imgData,ts:m.ts,uid:m.uid,mod:verifiedModUids.has(m.uid)});
      if(srv===CS()&&cn===CS().ch)render();
    }
    delete pendingChunks[d.imgId];
  }
}

