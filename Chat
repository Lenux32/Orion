function initVCPeer(){
  if(vcPeer)return;
  var vid='vc-'+S.uid+'-'+Math.random().toString(36).substr(2,4);
  vcPeer=new Peer(vid,{debug:0,config:{iceServers:[{urls:'stun:stun.l.google.com:19302'},{urls:'stun:stun1.l.google.com:19302'},{urls:'stun:stun2.l.google.com:19302'}]}});
  vcPeer.on('open',function(){
    console.log('[VC] PeerJS ready:',vid);
    if(CS()&&CS().vc){
      pub(sc('sys'),{t:'vcjoin',uid:S.uid,u:S.u,ac:S.ac,nc:S.nc,pic:S.customPic||null,ch:CS().vc,vpid:vcPeer.id});
      connectVCParticipants(CS().vc);connectVideoParticipants();
    }
  });
  vcPeer.on('call',function(call){
    if(call.metadata&&call.metadata.video){
      if(vcVideoCalls[call.peer]){try{vcVideoCalls[call.peer].close()}catch(e){}}
      vcVideoCalls[call.peer]=call;
      call.answer(vcVideoStream||undefined);
      call.on('stream',function(stream){vcVideoStreams[call.peer]=stream;renderVideoRoom();});
      call.on('close',function(){if(vcVideoCalls[call.peer]===call)delete vcVideoCalls[call.peer];delete vcVideoStreams[call.peer];renderVideoRoom();});
      return;
    }
    if(vcCalls[call.peer]){try{vcCalls[call.peer].close()}catch(e){}}
    vcCalls[call.peer]=call;
    if(vcLocalStream)call.answer(vcLocalStream);else call.answer();
    call.on('stream',function(rs){playVCStream(call.peer,rs);watchVoiceLevel(call.peer,rs)});
    call.on('close',function(){if(vcCalls[call.peer]===call)delete vcCalls[call.peer];removeVCStream(call.peer);stopVoiceMeter(call.peer)});
  });
  vcPeer.on('error',function(e){console.log('[VC] Peer error:',e.type,e.message)});
}

function connectVCParticipants(ch){
  if(!vcLocalStream||!vcPeer||!vcPeer.open||!CS())return;
  var keys=Object.keys(CS().mem);
  for(var i=0;i<keys.length;i++){
    var p=CS().mem[keys[i]];
    if(p.vc!==ch||!p.vpid||p.vpid===vcPeer.id||vcCalls[p.vpid]||S.uid>keys[i])continue;
    let call=vcPeer.call(p.vpid,vcLocalStream);
    if(!call)continue;
    vcCalls[p.vpid]=call;
    call.on('stream',function(rs){playVCStream(call.peer,rs)});
    call.on('close',function(){if(vcCalls[call.peer]===call)delete vcCalls[call.peer];removeVCStream(call.peer)});
  }
}

function videoUserId(peerId){
  if(!CS())return peerId;
  var keys=Object.keys(CS().mem);
  for(var i=0;i<keys.length;i++)if(CS().mem[keys[i]].vpid===peerId)return keys[i];
  return peerId;
}
function setVideoSpeaking(uid,on){
  var el=$('vav-'+encodeURIComponent(uid));
  if(el)el.classList.toggle('speaking',!!on);
}
function stopVoiceMeter(id){
  var meter=vcVoiceMeters[id];if(!meter)return;
  clearInterval(meter.timer);
  try{meter.context.close()}catch(e){}
  delete vcVoiceMeters[id];
}
function watchVoiceLevel(id,stream){
  stopVoiceMeter(id);
  if(!stream||!stream.getAudioTracks().some(function(t){return t.readyState==='live'}))return;
  try{
    var context=new (window.AudioContext||window.webkitAudioContext)();
    var analyser=context.createAnalyser();analyser.fftSize=256;
    context.createMediaStreamSource(stream).connect(analyser);
    var data=new Uint8Array(analyser.fftSize),active=false;
    var meter={context:context,timer:null,active:false};vcVoiceMeters[id]=meter;
    meter.timer=setInterval(function(){
      analyser.getByteTimeDomainData(data);var sum=0;
      for(var i=0;i<data.length;i++){var sample=(data[i]-128)/128;sum+=sample*sample;}
      var talking=Math.sqrt(sum/data.length)>.035;meter.active=talking;
      if(talking!==active){active=talking;setVideoSpeaking(id==='self'?S.uid:videoUserId(id),talking);}
    },100);
    if(context.state==='suspended')context.resume().catch(function(){});
  }catch(e){}
}
function renderVideoRoom(){
  var room=$('videoRoom');if(!room)return;
  var active=!!videoChatOpen||!!vcVideoStream||Object.keys(vcVideoStreams).length>0;
  room.classList.toggle('vis',!!(CS()&&CS().vc&&active));
  if(!CS()||!CS().vc||!active){room.innerHTML='';return;}
  var people=[{uid:S.uid,name:S.u,pic:S.customPic||null,peer:vcPeer&&vcPeer.id||null,self:true}],keys=Object.keys(CS().mem);
  for(var i=0;i<keys.length;i++){
    var p=CS().mem[keys[i]];
    if(p.vc===CS().vc&&!isHiddenUser(keys[i]))people.push({uid:keys[i],name:p.u,pic:p.pic||null,peer:p.vpid,self:false});
  }
  room.innerHTML=people.map(function(person){
    var pic=typeof person.pic==='string'&&/^data:image\/(png|jpeg|webp|gif);base64,[A-Za-z0-9+/]+=*$/.test(person.pic)?'background-image:url('+person.pic+');':'';
    return '<div class="video-tile"><video id="vvid-'+encodeURIComponent(person.uid)+'" autoplay playsinline muted hidden></video><div class="video-avatar-wrap"><div class="video-avatar" id="vav-'+encodeURIComponent(person.uid)+'" style="'+pic+'background-color:'+(person.self?S.ac:(CS().mem[person.uid]&&CS().mem[person.uid].ac)||'var(--br)')+'">'+(pic?'':esc(ini(person.name)))+'</div></div><div class="video-tile-name">'+esc(person.name)+(person.self?' (you)':'')+'</div></div>';
  }).join('');
  people.forEach(function(person){
    var video=$('vvid-'+encodeURIComponent(person.uid));
    var stream=person.self?vcVideoStream:(person.peer&&vcVideoStreams[person.peer]);
    if(!video||!stream)return;
    if(video.srcObject!==stream)video.srcObject=stream;
    var hasVideo=stream.getVideoTracks().some(function(track){return track.readyState==='live'&&track.enabled;});
    video.hidden=!hasVideo;
    if(hasVideo)video.play().catch(function(){});
  });
  Object.keys(vcVoiceMeters).forEach(function(id){var meter=vcVoiceMeters[id];setVideoSpeaking(id==='self'?S.uid:videoUserId(id),meter.active);});
}
function connectVideoParticipants(){
  if(!vcVideoStream||!vcPeer||!vcPeer.open||!CS()||!CS().vc)return;
  var keys=Object.keys(CS().mem);
  for(var i=0;i<keys.length;i++){
    var p=CS().mem[keys[i]];
    if(p.vc!==CS().vc||!p.vpid||p.vpid===vcPeer.id||vcVideoCalls[p.vpid])continue;
    var call=vcPeer.call(p.vpid,vcVideoStream,{metadata:{video:true}});
    if(!call)continue;
    vcVideoCalls[p.vpid]=call;
    call.on('stream',function(stream){vcVideoStreams[call.peer]=stream;renderVideoRoom();});
    call.on('close',function(){if(vcVideoCalls[call.peer]===call)delete vcVideoCalls[call.peer];delete vcVideoStreams[call.peer];renderVideoRoom();});
  }
}
async function toggleVideoChat(){
