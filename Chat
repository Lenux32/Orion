  $('msgToastSrv').textContent=srvName;
  var av=$('msgToastAv');
  var avColor=msg.ac||hc(msg.a,CL);
  if(msg.pic){av.style.backgroundImage='url('+msg.pic+')';av.style.backgroundColor=avColor;av.textContent='';}
  else{av.style.backgroundImage='';av.style.backgroundColor=avColor;av.textContent=ini(msg.a);}
  $('msgToastName').textContent=msg.a;
  var preview=msg.x?msg.x:(msg.img?'[image]':'');
  if(preview.length>80)preview=preview.substr(0,80)+'…';
  $('msgToastText').textContent=preview;
  $('msgToast').classList.add('vis');
  _toastTimer=setTimeout(function(){$('msgToast').classList.remove('vis');_toastSrvIdx=null;},5000);
}
