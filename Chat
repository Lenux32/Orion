function srvForChannel(ch){
  for(var i=0;i<S.servers.length;i++){if(ch.indexOf('dcc.'+S.servers[i].code+'.')===0)return S.servers[i];}return null;
}

function onMsg(e){
  var d=e.message,ch=e.channel;
  if(ch===dmInviteChannel(S.uid)){
    if(d.t==='dm_invite'&&d.from!==S.uid&&!isHiddenUser(d.from)){
      _pendingDmInvite={code:d.code,fromName:d.fromName,fromUid:d.from};
      $('dmNotifBody').textContent=esc(d.fromName)+' wants to start a DM with you.';
      $('dmNotif').classList.add('vis');
    }
    return;
  }
  var srv=srvForChannel(ch);if(!srv)return;
  var sysC=scp(srv.code,'sys');

  if(ch===sysC){
    if(d.uid===S.uid)return;
    var myVpid=vcPeer&&vcPeer.id?vcPeer.id:null;
    if(d.t==='join'){
      checkVersion(d.v);
      if(srv.banned[d.uid])return;
      var isMod=verifiedModUids.has(d.uid);
      var isTmod=verifiedTmodUids.has(d.uid);
      var isDev=verifiedDevUids.has(d.uid);
      if(!srv.mem[d.uid])addSysTo(srv,srv===CS()?CS().ch:'general',d.u+' joined');
      srv.mem[d.uid]={u:d.u,ac:d.ac,nc:d.nc,bio:d.bio||'',pic:d.pic||null,banner:validBannerData(d.banner)?d.banner:null,vc:d.vc||null,vpid:d.vpid||null,mod:isMod,tmod:isTmod,dev:isDev,last:Date.now()};
      pub(sysC,{t:'here',uid:S.uid,u:S.u,ac:S.ac,nc:S.nc,bio:S.bio||'',pic:S.customPic||null,banner:S.banner||null,vc:srv.vc,vpid:myVpid,mod:_mod.isMod(),tmod:_mod.isTmod(),dev:_mod.isOwner(),modHash:'',devHash:'',v:CLIENT_VERSION,for:d.uid});
      if(srv===CS()){render();updMem();updVC()}
    }
    else if(d.t==='here'&&d.for===S.uid){
      checkVersion(d.v);
      srv.mem[d.uid]={u:d.u,ac:d.ac,nc:d.nc,bio:d.bio||'',pic:d.pic||null,banner:validBannerData(d.banner)?d.banner:null,vc:d.vc||null,vpid:d.vpid||null,mod:verifiedModUids.has(d.uid),tmod:verifiedTmodUids.has(d.uid),dev:verifiedDevUids.has(d.uid),last:Date.now()};
      if(srv===CS()){updMem();updVC()}
    }
    else if(d.t==='rollcall'){pub(sysC,{t:'here',uid:S.uid,u:S.u,ac:S.ac,nc:S.nc,bio:S.bio||'',pic:S.customPic||null,banner:S.banner||null,vc:srv.vc,vpid:myVpid,mod:_mod.isMod(),tmod:_mod.isTmod(),dev:_mod.isOwner(),modHash:'',devHash:'',v:CLIENT_VERSION,for:d.uid})}
    else if(d.t==='hb'){
      checkVersion(d.v);
      srv.mem[d.uid]={u:d.u,ac:d.ac,nc:d.nc,bio:d.bio||'',pic:d.pic||null,banner:validBannerData(d.banner)?d.banner:null,vc:d.vc||null,vpid:d.vpid||null,mod:verifiedModUids.has(d.uid),tmod:verifiedTmodUids.has(d.uid),dev:verifiedDevUids.has(d.uid),last:Date.now()};
      if(srv===CS()){updMem();updVC()}
    }
    else if(d.t==='leave'){if(srv.mem[d.uid]){addSysTo(srv,srv===CS()?CS().ch:'general',srv.mem[d.uid].u+' left');delete srv.mem[d.uid];if(srv===CS()){render();updMem();updVC()}}}
    else if(d.t==='vcjoin'){
      if(srv.mem[d.uid]){srv.mem[d.uid].vc=d.ch;srv.mem[d.uid].vpid=d.vpid||null}
      else srv.mem[d.uid]={u:d.u,ac:d.ac,nc:d.nc,bio:d.bio||'',vc:d.ch,vpid:d.vpid||null,last:Date.now()};
      if(srv===CS()){
        updVC();
        if(CS().vc===d.ch){connectVCParticipants(d.ch);connectVideoParticipants();renderVideoRoom()}
      }
    }
    else if(d.t==='vcleave'){
      if(srv.mem[d.uid]){
        var leavingPeer=srv.mem[d.uid].vpid;
        if(leavingPeer){removeVCStream(leavingPeer);stopVoiceMeter(leavingPeer);if(vcVideoCalls[leavingPeer]){try{vcVideoCalls[leavingPeer].close()}catch(e){}}delete vcVideoCalls[leavingPeer];delete vcVideoStreams[leavingPeer];}
        srv.mem[d.uid].vc=null;srv.mem[d.uid].vpid=null;
      }
      if(srv===CS())updVC();
    }
    return;
  }

  var cn=ch.replace('dcc.'+srv.code+'.','');
  if(isOwnerOnlyChannel(cn)&&!verifiedDevUids.has(d.uid))return;
  if(d.uid===S.uid||isHiddenUser(d.uid))return;
  if(d.t==='react'){
    if(d.emoji!=='👍'||!srv.ms[cn])return;
    var target=srv.ms[cn].find(function(m){return m.ts===d.ts&&m.uid===d.muid;});
    if(target){target.reactions=target.reactions||{};if(target.reactions[d.uid])delete target.reactions[d.uid];else target.reactions[d.uid]='👍';if(srv===CS()&&cn===CS().ch)render();}
    return;
  }
  if(d.t==='msg'&&srv.mem[d.uid]&&srv.mem[d.uid].muted)return;
  if(d.t==='msg'&&srv.ms[cn]){
    if(!srv.ms[cn].some(function(m){return m.ts===d.ts&&m.uid===d.uid})){
      var pane=$('mw'),activeHere=srv===CS()&&cn===CS().ch,atBottomNow=pane&&pane.scrollTop+pane.clientHeight>=pane.scrollHeight-80;
      if(!activeHere||!atBottomNow){var unreadKey=channelKey(srv.code,cn);srv.unread=srv.unread||{};srv.newTs=srv.newTs||{};srv.newDividerPending=srv.newDividerPending||{};if(!srv.unread[unreadKey]){srv.newTs[unreadKey]=d.ts;srv.newDividerPending[unreadKey]=true;}srv.unread[unreadKey]=(srv.unread[unreadKey]||0)+1;renderChannels();renderSrvIcons();}

      var _modFx=['shout','rainbow','big','tiny','matrix','ghost'];
      var _safeFx=(d.fx&&_modFx.indexOf(d.fx)>=0&&!verifiedModUids.has(d.uid)&&!verifiedDevUids.has(d.uid))?null:d.fx;
      srv.ms[cn].push({t:'u',a:d.u,ac:d.ac,nc:d.nc,pic:d.pic||null,x:d.x,img:d.img||null,voice:validVoiceData(d.voice)?d.voice:null,fx:_safeFx,ann:!!d.ann,ts:d.ts,uid:d.uid,mod:verifiedModUids.has(d.uid),req:d.req||''});
      notifyMention(srv,d);
      if(srv===CS()&&cn===CS().ch){render();}
      else if(srv!==CS()){var si=S.servers.indexOf(srv);showMsgToast(si,srv.name,{a:d.u,ac:d.ac,nc:d.nc,pic:d.pic||null,x:d.x,img:d.img||null});}
    }
  }
  else if(d.t==='sticker'&&srv.ms[cn]&&validStickerUrl(d.sticker)){
    if(!srv.ms[cn].some(function(m){return m.ts===d.ts&&m.uid===d.uid})){
      srv.ms[cn].push({t:'u',a:d.u,ac:d.ac,nc:d.nc,pic:d.pic||null,x:'',sticker:d.sticker,ts:d.ts,uid:d.uid,mod:verifiedModUids.has(d.uid)});
      if(srv===CS()&&cn===CS().ch)render();
      else if(srv!==CS())showMsgToast(S.servers.indexOf(srv),srv.name,{a:d.u,ac:d.ac,nc:d.nc,pic:d.pic||null,x:'[sticker]'});
    }
  }
  else if(d.t==='img_meta'&&srv.ms[cn]){handleImgMeta(srv,cn,d);}
  else if(d.t==='img_chunk'){handleImgChunk(srv,cn,d);}
}

function reapMembers(){
  var now=Date.now();
  S.servers.forEach(function(srv){
    var changed=false,keys=Object.keys(srv.mem);
    for(var i=0;i<keys.length;i++){
      if(now-srv.mem[keys[i]].last>20000){addSysTo(srv,srv===CS()?CS().ch:'general',srv.mem[keys[i]].u+' went offline');delete srv.mem[keys[i]];changed=true;}
    }
    if(changed&&srv===CS()){render();updMem();updVC()}
  });
}

