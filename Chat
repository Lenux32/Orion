async function sha256(str){
  var enc=new TextEncoder();
  var key=await crypto.subtle.importKey('raw',enc.encode(str),{name:'PBKDF2'},false,['deriveBits']);
  var bits=await crypto.subtle.deriveBits({name:'PBKDF2',salt:enc.encode('chatcord_v9_salt'),iterations:310000,hash:'SHA-256'},key,256);
  return Array.from(new Uint8Array(bits)).map(function(b){return b.toString(16).padStart(2,'0')}).join('');
}

