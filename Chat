  var profile=null;try{profile=JSON.parse(localStorage.getItem('dc_profile_'+S.uid)||'null')}catch(e){}
  S.u=n;
  S.ac=hc(S.u,CL);S.nc=hc(S.u+(new Date().toDateString()),NC);
