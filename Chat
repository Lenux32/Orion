function handleFiles(files){
  if(!files||!files.length)return;
  S.pendingImgs=[];
  var loaded=0,total=Math.min(files.length,4);
  for(var i=0;i<total;i++){
    (function(f){
      var reader=new FileReader();
      reader.onload=function(e){
        var img=new Image();
        img.onload=function(){
          var canvas=document.createElement('canvas');
          var maxW=480,maxH=360;
          var w=img.width,ht=img.height;
          if(w>maxW){ht*=maxW/w;w=maxW}
          if(ht>maxH){w*=maxH/ht;ht=maxH}
          canvas.width=w;canvas.height=ht;
          var ctx=canvas.getContext('2d');
          ctx.drawImage(img,0,0,w,ht);
          var data=canvas.toDataURL('image/jpeg',0.45);
          S.pendingImgs.push(data);loaded++;
          if(loaded===total)showImgPreview();
        };
        img.src=e.target.result;
      };
      reader.readAsDataURL(f);
    })(files[i]);
  }
  $('fileInput').value='';
}

function showImgPreview(){
  var el=$('imgPreview');var h='';
  S.pendingImgs.forEach(function(src,i){h+='<div class="img-preview-thumb"><img src="'+src+'"><div class="img-preview-close" onclick="removeImg('+i+')">&times;</div></div>';});
