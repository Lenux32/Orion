// Lightweight ambient particles and click ripples; no external assets or input interception.
(function initAmbientCanvas(){
  var canvas=$('ambientCanvas');if(!canvas)return;
  var ctx=canvas.getContext('2d');if(!ctx)return;
  var width=0,height=0,particles=[],ripples=[],mouse={x:-1000,y:-1000};
  function resize(){
    var dpr=Math.min(window.devicePixelRatio||1,1.5);
    width=window.innerWidth;height=window.innerHeight;
    canvas.width=Math.round(width*dpr);canvas.height=Math.round(height*dpr);
    ctx.setTransform(dpr,0,0,dpr,0,0);
    particles=Array.from({length:Math.min(75,Math.floor(width*height/15000))},function(){return{x:Math.random()*width,y:Math.random()*height,r:Math.random()*1.6+.5,dx:(Math.random()-.5)*.2,dy:-(Math.random()*.28+.08),a:Math.random()*.38+.12};});
  }
  function pointerMove(e){mouse.x=e.clientX;mouse.y=e.clientY;}
  function addRipple(e){ripples.push({x:e.clientX,y:e.clientY,r:2,a:.42});if(ripples.length>8)ripples.shift();}
  function draw(){
    ctx.clearRect(0,0,width,height);
    particles.forEach(function(p){
      var dx=mouse.x-p.x,dy=mouse.y-p.y,dist=Math.sqrt(dx*dx+dy*dy);
      if(dist<120&&dist>1){p.x-=dx/dist*.22;p.y-=dy/dist*.22;}
      p.x+=p.dx;p.y+=p.dy;
      if(p.x<0)p.x=width;if(p.x>width)p.x=0;if(p.y< -8){p.y=height+8;p.x=Math.random()*width;}
      ctx.beginPath();ctx.arc(p.x,p.y,p.r,0,Math.PI*2);ctx.fillStyle='rgba(149,170,255,'+p.a+')';ctx.fill();
    });
    ripples=ripples.filter(function(r){return r.a>.015;});
    ripples.forEach(function(r){ctx.beginPath();ctx.arc(r.x,r.y,r.r,0,Math.PI*2);ctx.strokeStyle='rgba(135,157,255,'+r.a+')';ctx.lineWidth=1.5;ctx.stroke();r.r+=2.1;r.a*=.965;});
    requestAnimationFrame(draw);
  }
  window.addEventListener('resize',resize,{passive:true});
  window.addEventListener('pointermove',pointerMove,{passive:true});
  window.addEventListener('pointerdown',addRipple,{passive:true});
  resize();requestAnimationFrame(draw);
})();

