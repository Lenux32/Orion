  if(data.choices&&data.choices[0]){var c=data.choices[0];if(c.message&&c.message.content)return c.message.content;if(c.text)return c.text;}
  if(typeof data.response==='string')return data.response;
  if(typeof data.reply==='string')return data.reply;
