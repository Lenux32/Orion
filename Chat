<script>
'use strict';

// ═══════ AUTHORITY SERVER ═══════

// ── Closure-protected rank state — impossible to set from devtools ──
var _auth = (function(){
  var _rank = null;
  // Full permission map keyed by rank — no server trust needed for perm lookup
  // Permissions are defined here client-side as a mirror of the server's RANKS object.
  // The SERVER still validates every action — these just control UI visibility.
  var _PERM_MAP = {
    owner: {canBan:true,canKick:true,canMute:true,canDelete:true,canPromote:true,canWipeChat:true,canGlobalMute:true},
    admin: {canBan:true,canKick:true,canMute:true,canDelete:true,canPromote:false,canWipeChat:false,canGlobalMute:false},
    mod:   {canBan:false,canKick:true,canMute:true,canDelete:true,canPromote:false,canWipeChat:false,canGlobalMute:false},
    tmod:  {canBan:false,canKick:true,canMute:true,canDelete:false,canPromote:false,canWipeChat:false,canGlobalMute:false}
  };
  // _setRank is the ONLY way to change rank — only callable from handleAuthMsg
  // which only fires on a genuine WebSocket message from the authority server.
  // No global variable is exposed, so devtools cannot call _auth._setRank or
  // assign _myRank — those names don't exist in the outer scope.
  return Object.freeze({
    rank:    function(){ return _rank; },
    isAny:   function(){ return _rank !== null; },
    isMod:   function(){ return _rank==='mod'||_rank==='admin'||_rank==='owner'; },
    isTmod:  function(){ return _rank==='tmod'; },
    isAdmin: function(){ return _rank==='admin'||_rank==='owner'; },
    isOwner: function(){ return _rank==='owner'; },
    can:     function(perm){ return !!(_rank && _PERM_MAP[_rank] && _PERM_MAP[_rank][perm]); },
    _setRank:function(r){ if(r===null||_PERM_MAP[r]){ _rank=r; } }
  });
})();

// Alias so existing code that calls _mod.xxx still works
var _mod = _auth;

// ── Closure-protected member rank map — no outer variable exposed ──
var _ranks = (function(){
  var _map = {};
  return Object.freeze({
    set:    function(uid,r){ _map[uid]=r||null; },
    get:    function(uid){ return _map[uid]||null; },
    del:    function(uid){ delete _map[uid]; },
    clear:  function(){ _map={}; },
    isMod:  function(uid){ var r=_map[uid]; return r==='mod'||r==='admin'||r==='owner'; },
    isTmod: function(uid){ return _map[uid]==='tmod'; },
    isOwner:function(uid){ return _map[uid]==='owner'; },
    badge:  function(uid){
      var r=_map[uid];
      if(r==='owner') return '<span class="owner-badge" title="Verified owner"><svg class="owner-check" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="7" fill="currentColor"/><path d="m4.5 8.2 2.2 2.1 4.8-5" fill="none" stroke="#b42318" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>OWNER</span>';
      if(r==='admin') return '<span class="admin-badge">ADMIN</span>';
      if(r==='mod')   return '<span class="mod-badge">MOD</span>';
      if(r==='tmod')  return '<span class="mod-badge" style="background:#e67e22">TMOD</span>';
      return '';
    }
  });
})();

// Keep verifiedModUids etc. pointing at _ranks for legacy code compatibility
var verifiedModUids  = Object.freeze({ has: function(uid){ return _ranks.isMod(uid); } });
var verifiedTmodUids = Object.freeze({ has: function(uid){ return _ranks.isTmod(uid); } });
var verifiedDevUids  = Object.freeze({ has: function(uid){ return _ranks.isOwner(uid); } });



function handleAuthMsg(msg){
  switch(msg.t){
    case 'registered':
      _ranks.clear();
      (msg.members||[]).forEach(function(m){ if(m.rank) _ranks.set(m.uid, m.rank); });
      if(msg.muted){ _mute.set(true); render && render(); }
      updMem && updMem();
      break;

    case 'auth_ok':
      _auth._setRank(msg.rank);
      var rl=$('myRankLabel'); if(rl) rl.textContent=msg.rank.toUpperCase();
      var ab=$('authBar'); ab.textContent='Authenticated as '+msg.rank.toUpperCase(); ab.classList.add('vis');
      setTimeout(function(){ ab.classList.remove('vis'); }, 4000);
      if(CS){ addSys(CS().ch, 'Authenticated as '+msg.rank.toUpperCase()); render(); }
      updBotPlaceholder && updBotPlaceholder();
      updMem && updMem();
      break;

    case 'auth_fail':
      if(CS){ addSys(CS().ch, 'Auth failed: '+(msg.reason||'wrong password')); render(); }
      break;

    case 'rank_update':
      _ranks.set(msg.uid, msg.rank);
      updMem && updMem(); render && render();
      break;

    case 'banned':
      if($('banSrv')) $('banSrv').textContent='this server';
      if($('banBy'))  $('banBy').textContent=msg.by||'a moderator';
      if($('banScreen')) $('banScreen').classList.add('vis');
      if(pn){ clearInterval(hbTimer); try{ pn.unsubscribeAll(); }catch(e){} }
      break;

    case 'kicked':
      if($('kickSrv')) $('kickSrv').textContent='this server';
      if($('kickBy'))  $('kickBy').textContent=msg.by||'a moderator';
      var kmd=$('kickMsgDisplay');
      if(kmd) kmd.innerHTML=msg.reason?' &mdash; <span style="color:#f47b67;font-style:italic">"'+esc(msg.reason)+'"</span>':'';
      if($('kickScreen')) $('kickScreen').classList.add('vis');
      if(pn){ clearInterval(hbTimer); try{ pn.unsubscribeAll(); }catch(e){} }
      break;

    case 'kicked_cooldown':
      if($('kickSrv')) $('kickSrv').textContent='this server';
      if($('kickBy'))  $('kickBy').textContent=msg.by||'a moderator';
      var kmd2=$('kickMsgDisplay'); if(kmd2) kmd2.textContent=' — wait '+msg.secs+'s before rejoining.';
      if($('kickScreen')) $('kickScreen').classList.add('vis');
      break;

    case 'member_kicked':
      if(CS && CS().mem){ delete CS().mem[msg.uid]; }
      if(CS){ addSys(CS().ch, msg.name+' was kicked by '+msg.by+(msg.reason?' ('+msg.reason+')':'')); }
      render && render(); updMem && updMem();
      break;

    case 'member_banned':
      if(CS && CS()){ CS().banned=CS().banned||{}; CS().banned[msg.uid]=true; delete CS().mem[msg.uid]; }
      if(CS){ addSys(CS().ch, msg.name+' was banned by '+msg.by); }
      render && render(); updMem && updMem();
      break;

    case 'member_joined':
      _ranks.set(msg.uid, msg.rank||null);
      updMem && updMem();
      break;

    case 'member_left':
      _ranks.del(msg.uid);
      updMem && updMem();
      break;

    case 'muted':
      _mute.set(true);
      if(CS){ addSys(CS().ch, 'You were muted by '+msg.by+(msg.duration?' for '+msg.duration+'s':'')); }
      render && render();
      if(msg.duration){ setTimeout(function(){ _mute.set(false); render && render(); }, msg.duration*1000); }
      break;

    case 'unmuted':
      _mute.set(false);
      if(CS){ addSys(CS().ch, 'You were unmuted'+(msg.by?' by '+msg.by:'')); }
      render && render();
      break;

    case 'member_muted':
      if(CS && CS().mem && CS().mem[msg.uid]) CS().mem[msg.uid].muted=true;
      if(CS){ addSys(CS().ch, msg.name+' was muted by '+msg.by); }
      render && render(); updMem && updMem();
      break;

    case 'member_unmuted':
      if(CS && CS().mem && CS().mem[msg.uid]) CS().mem[msg.uid].muted=false;
      render && render(); updMem && updMem();
      break;

    case 'msg_deleted':
      if(CS && CS().ms && CS().ms[msg.ch]){
        CS().ms[msg.ch]=CS().ms[msg.ch].filter(function(m){ return !(m.ts===msg.ts && m.uid===msg.muid); });
        if(CS().ch===msg.ch) render && render();
      }
      break;

    case 'chat_wiped':
      if(CS){ Object.keys(CS().ms).forEach(function(ch){ CS().ms[ch]=[]; }); render && render(); }
      break;

    case 'global_muted':
      if(CS){ addSys(CS().ch, 'Global mute for '+msg.secs+'s by '+msg.by); render && render(); }
      break;

    case 'denied':
      if(CS){ addSys(CS().ch, msg.action+' denied: '+msg.reason); render && render(); }
      break;

    case 'ban_list':
      if(CS){
        var list=msg.list||[];
        addSys(CS().ch, list.length ? 'Banned ('+list.length+'): '+list.map(function(b){return b.uid+' (by '+b.by+')'}).join(', ') : 'Ban list is empty');
        render && render();
      }
      break;
  }
}

// ═══════ AUTHORITY SERVER (via PubNub — works through school firewalls) ═══════
var PN_PUB = 'pub-c-42ad065d-2f90-4a76-ad59-9e0b76246c44';
var PN_SUB = 'sub-c-7e966938-f323-4f57-a793-ee27ddd6dfaa';
var AUTH_ACTION_CH = 'cc.mod.actions';   // client → server
var _authResultCh  = null;               // server → this client (set after join)
var _authReady     = false;
var _authPn        = null;               // separate PubNub instance for authority

// ── Closure-protected credential store ──
var _creds = (function(){
  var _r = null, _p = null;
  return Object.freeze({
    save: function(rank, pw){ _r=rank; _p=pw; },
    has:  function(){ return !!_r && !!_p; },
    rank: function(){ return _r; },
    pw:   function(){ return _p; }
  });
})();

function connectAuthority() {
  if (!S.uid) return;
  _authResultCh = 'cc.mod.results.' + S.uid;

  _authPn = new PubNub({ publishKey: PN_PUB, subscribeKey: PN_SUB, userId: 'auth-' + S.uid });
  _authPn.addListener({
    status: function(e) {
      if (e.category === 'PNConnectedCategory') {
        _authReady = true;
        // Register with server
        _authPub({ t: 'register', uid: S.uid, name: S.u, server: CS ? CS().code : 'global' });
        // Auto-reauth if credentials saved
        if (_creds.has()) {
          setTimeout(function(){
            _authPub({ t: 'auth', uid: S.uid, rank: _creds.rank(), password: _creds.pw() });
          }, 1000);
        }
        // Heartbeat every 20s so server knows we're alive
        setInterval(function(){
          _authPub({ t: 'heartbeat', uid: S.uid });
        }, 20000);
        var ab = $('authBar');
        ab.textContent = 'Authority server connected';
        ab.classList.add('vis');
        setTimeout(function(){ ab.classList.remove('vis'); }, 3000);
      }
    },
    message: function(e) {
      handleAuthMsg(e.message);
    }
  });
  _authPn.subscribe({ channels: [_authResultCh] });
}

function _authPub(msg) {
  if (!_authPn) return;
  _authPn.publish({ channel: AUTH_ACTION_CH, message: msg }).catch(function(e){
    console.log('[auth pub err]', e.message||e);
  });
}

function authAction(body) {
  _authPub(Object.assign({ uid: S.uid }, body));
}

function authRank(rank, password) {
  _creds.save(rank, password);
  _authPub({ t: 'auth', uid: S.uid, rank: rank, password: password });
}

