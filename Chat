async function callBotApi(userMsg){
  var lastErr='unknown error';
  for(var ei=0;ei<_botEndpoints.length;ei++){
    var ep=_botEndpoints[ei];
    try{
      var res=await fetch(ep.url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(ep.body(userMsg))});
      var raw=await res.text();
      if(!res.ok){lastErr='HTTP '+res.status;continue;}
      var data;try{data=JSON.parse(raw);}catch(pe){lastErr='Bad JSON';continue;}
      var txt=_extractBotText(data);
      if(txt)return txt.trim();
