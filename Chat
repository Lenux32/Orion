    <!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Discord Clone</title>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdn.pubnub.com/sdk/javascript/pubnub.8.6.0.js"></script>
<script src="https://unpkg.com/peerjs@1.5.2/dist/peerjs.min.js"></script>
<style>
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
:root{--bt:#1e1f22;--bs:#2b2d31;--bp:#313338;--mh:rgba(79,84,92,.16);--ms:rgba(79,84,92,.32);--ct:#949ba4;--ch:#dbdee1;--tn:#dbdee1;--tm:#949ba4;--tl:#00a8fc;--hp:#f2f3f5;--hs:#b5bac1;--br:#5865f2;--bd:#4752c4;--gn:#23a559;--rd:#f23f43;--yl:#fee75c;--ib:#1e1f22;--sep:#3f4147}
html,body{height:100%;overflow:hidden;font-family:'Noto Sans',sans-serif;background:var(--bp);color:var(--tn);font-size:16px;line-height:1.375}
::-webkit-scrollbar{width:8px}::-webkit-scrollbar-track{background:var(--bs)}::-webkit-scrollbar-thumb{background:#1a1b1e;border-radius:4px}
button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit}
input,textarea{font-family:inherit;border:none;outline:none;color:var(--tn)}
.app{display:flex;height:100vh}
.srv-list{width:72px;min-width:72px;background:var(--bt);display:flex;flex-direction:column;align-items:center;padding:12px 0;gap:8px;overflow-y:auto}
.srv-ico{width:48px;height:48px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:var(--bp);color:var(--tn);font-weight:600;font-size:18px;cursor:pointer;transition:border-radius .15s,background .15s;position:relative}
.srv-ico:hover,.srv-ico.on{border-radius:16px;background:var(--br);color:#fff}
.srv-ico.add{color:var(--gn);font-size:24px}.srv-ico.add:hover{background:var(--gn);color:#fff;border-radius:16px}
.srv-sep{width:32px;height:2px;background:var(--sep);border-radius:1px}
.srv-badge{position:absolute;bottom:-2px;right:-2px;background:var(--rd);color:#fff;font-size:10px;font-weight:700;min-width:16px;height:16px;border-radius:8px;display:flex;align-items:center;justify-content:center;padding:0 4px;border:3px solid var(--bt);display:none}
.tooltip{position:fixed;background:#111;color:#fff;font-size:14px;font-weight:600;padding:8px 12px;border-radius:4px;pointer-events:none;z-index:999;white-space:nowrap;display:none}
.ch-side{width:240px;min-width:240px;background:var(--bs);display:flex;flex-direction:column}
.srv-hdr{height:48px;padding:0 16px;display:flex;align-items:center;justify-content:space-between;box-shadow:0 1px 0 rgba(0,0,0,.2);font-weight:600;font-size:15px;color:var(--hp);flex-shrink:0}
.ch-list{flex:1;overflow-y:auto}
.ch-cat{padding:16px 8px 0 16px;font-size:12px;font-weight:600;text-transform:uppercase;color:var(--ct);letter-spacing:.02em;cursor:pointer;display:flex;align-items:center;gap:2px}
.ch-item{display:flex;align-items:center;padding:6px 8px;margin:1px 8px;border-radius:4px;cursor:pointer;color:var(--ct);font-size:15px;font-weight:500;gap:6px}
.ch-item:hover{background:var(--mh);color:var(--ch)}.ch-item.on{background:var(--ms);color:#fff}
.ch-item svg{flex-shrink:0;width:20px;height:20px;color:var(--ct)}.ch-item:hover svg,.ch-item.on svg{color:var(--ch)}
.vu{padding:4px 6px 4px 34px}
.vu-item{display:flex;align-items:center;gap:9px;padding:5px 8px;margin:2px 4px;border-radius:7px;font-size:12px;font-weight:600;color:var(--ct);background:rgba(255,255,255,.025)}
.vu-av{width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:#fff;overflow:hidden;flex-shrink:0;background-size:cover;background-position:center;border:1px solid rgba(255,255,255,.12)}
.vu-av img{width:100%;height:100%;object-fit:cover;border-radius:50%}
.vu-name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.vu-item.self{color:var(--hp);background:rgba(104,117,255,.11)}
.vu-item.speaking .vu-av{box-shadow:0 0 0 2px var(--gn),0 0 12px rgba(35,165,89,.45)}
.voice-status{display:none;align-items:center;justify-content:space-between;margin:0 16px 8px;padding:8px 12px;background:rgba(242,63,67,.1);border:1px solid rgba(242,63,67,.28);border-radius:8px;color:#ff8588;font-size:12px;font-weight:600}
.voice-status.vis{display:flex}
.voice-status-cancel{color:var(--tn);padding:3px 8px;border-radius:4px;background:var(--mh);font-size:11px}
.ci-b.recording{color:var(--rd);background:rgba(242,63,67,.12);border-radius:8px}
.mg-audio{display:block;width:min(360px,100%);height:40px;margin-top:6px;filter:invert(.9) hue-rotate(180deg);border-radius:20px}
.voice-msg-label{font-size:11px;color:var(--tm);margin-top:3px}
.up{height:52px;background:#232428;display:flex;align-items:center;padding:0 8px;gap:8px;flex-shrink:0}
.up-banner{width:32px;height:32px;border-radius:6px;display:flex;align-items:center;justify-content:center;flex-shrink:0;background-color:var(--bp);background-size:cover;background-position:center;color:var(--tm);font-size:18px;cursor:pointer;border:1px solid rgba(255,255,255,.08)}
.up-banner:hover{border-color:var(--br);color:var(--ch)}
.ua{width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:600;font-size:13px;color:#fff;flex-shrink:0;position:relative}
.ua .sd{position:absolute;bottom:-1px;right:-1px;width:10px;height:10px;border-radius:50%;border:2.5px solid #232428;background:var(--gn)}
.ui{flex:1;min-width:0}.ui-n{font-size:13px;font-weight:600;color:var(--hp);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;line-height:18px}.ui-t{font-size:12px;color:var(--hs);line-height:13px}
.ub{display:flex;gap:4px}
.ubtn{width:32px;height:32px;border-radius:4px;display:flex;align-items:center;justify-content:center;color:var(--tm);position:relative}
.ubtn:hover{background:var(--mh);color:var(--ch)}.ubtn.mt{color:var(--rd)}.ubtn.mt::after{content:'';position:absolute;width:28px;height:2px;background:var(--rd);transform:rotate(-45deg);border-radius:1px}
.main{flex:1;display:flex;flex-direction:column;min-width:0;background:var(--bp);height:100vh;overflow:hidden}
.ch-hdr{height:48px;padding:0 16px;display:flex;align-items:center;gap:8px;flex-shrink:0;box-shadow:0 1px 0 rgba(0,0,0,.2);z-index:1}
.ch-hdr-n{font-weight:600;font-size:16px;color:var(--hp)}.ch-hdr-d{width:1px;height:24px;background:var(--sep);margin:0 8px}
.ch-hdr-t{font-size:14px;color:var(--hs);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1}
.ch-hdr-b{width:24px;height:24px;display:flex;align-items:center;justify-content:center;color:var(--tm);cursor:pointer;border-radius:4px;margin-left:auto}.ch-hdr-b:hover{color:var(--ch)}
.msgs-w{flex:1;height:0;overflow-y:scroll;overflow-x:hidden;}
.msgs-s{min-height:100%;display:flex;flex-direction:column;}
.msgs-c{margin-top:auto;padding:0 0 24px;word-break:break-word;overflow-wrap:break-word;}
.mg{padding:2px 16px 2px 72px;position:relative;min-height:22px}.mg:hover{background:rgba(0,0,0,.06)}
.mg.hdr{margin-top:17px;min-height:44px}
.mg-av{position:absolute;left:16px;top:2px;width:40px;height:40px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:600;font-size:15px;color:#fff;cursor:pointer}
.mg-h{display:flex;align-items:baseline;gap:8px}.mg-a{font-weight:600;font-size:15px;cursor:pointer;line-height:22px}.mg-a:hover{text-decoration:underline}
.mg-ts{font-size:12px;color:var(--tm);font-weight:400;line-height:22px}
.mg-t{font-size:15px;line-height:1.375rem;color:var(--tn);word-wrap:break-word;white-space:pre-wrap}
.mg-t .men{background:rgba(88,101,242,.3);color:#dee0fc;padding:0 2px;border-radius:3px;font-weight:500}.mg-t .men:hover{background:var(--br);color:#fff}
.mg-img{max-width:400px;max-height:300px;border-radius:8px;margin-top:4px;cursor:pointer;display:block}
 .mg-img:hover{opacity:.9}
.mg-sticker{display:block;width:auto;max-width:220px;max-height:220px;object-fit:contain;border-radius:12px;margin-top:6px}
.sticker-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;padding:10px}
.sticker-option{display:flex;flex-direction:column;align-items:center;gap:6px;padding:8px;border-radius:8px;background:var(--bp);color:var(--tn);font-size:12px}
.sticker-option:hover{background:var(--mh)}
.sticker-option img{width:100%;max-height:120px;object-fit:contain;border-radius:6px}
.sticker-help{padding:0 10px 10px;font-size:11px;color:var(--tm)}
.sticker-help code{color:var(--ch)}
.prof-banner{cursor:pointer;background-size:cover;background-position:center;background-repeat:no-repeat;display:flex;align-items:flex-end;padding:10px 14px}
.prof-banner span{font-size:11px;color:#fff;background:rgba(0,0,0,.55);padding:4px 8px;border-radius:5px}
.sys{padding:4px 16px;font-size:13px;color:var(--tm)}
.welc{padding:16px 16px 0;margin-bottom:8px}
.welc-i{width:68px;height:68px;border-radius:50%;display:flex;align-items:center;justify-content:center;margin-bottom:8px}
.welc-t{font-size:32px;font-weight:700;color:var(--hp);margin-bottom:8px}.welc-d{font-size:14px;color:var(--tm)}
.mg-shout{font-size:36px;font-weight:900;line-height:1.1;color:#fff;word-wrap:break-word;white-space:pre-wrap;text-shadow:0 0 24px rgba(88,101,242,.7),0 2px 8px rgba(0,0,0,.5);letter-spacing:-0.5px;padding:4px 0}
.mg.shout-msg{background:rgba(88,101,242,.07);border-left:3px solid var(--br);padding-left:calc(72px - 3px)}
.mg.shout-msg:hover{background:rgba(88,101,242,.13)}
.ci-w{padding:0 16px 24px;flex-shrink:0}
.ci-c{background:var(--ib);border-radius:8px;display:flex;align-items:flex-end;position:relative}
.ci-b{width:44px;height:44px;display:flex;align-items:center;justify-content:center;color:var(--tm);flex-shrink:0;cursor:pointer}.ci-b:hover{color:var(--ch)}
.ci{flex:1;background:transparent;border:none;padding:11px 0;font-size:15px;color:var(--tn);resize:none;line-height:1.375;max-height:200px;min-height:44px}.ci::placeholder{color:var(--tm)}
.ti{font-size:12px;color:var(--tm);padding:4px 16px 0;height:24px;flex-shrink:0}
.img-preview{display:none;padding:8px 16px;flex-shrink:0}
.img-preview.vis{display:flex;align-items:flex-start;gap:8px}
.img-preview-thumb{position:relative;border-radius:8px;overflow:hidden;background:var(--bs);padding:8px;max-width:200px}
.img-preview-thumb img{max-width:180px;max-height:120px;border-radius:4px;display:block}
.img-preview-close{position:absolute;top:4px;right:4px;width:20px;height:20px;background:var(--bp);border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;color:var(--tm);font-size:14px}
.img-preview-close:hover{color:var(--ch)}
.mem-s{width:240px;min-width:240px;background:var(--bs);overflow-y:auto;padding:12px 8px;display:none}.mem-s.vis{display:block}
.mem-cat{padding:16px 8px 4px;font-size:12px;font-weight:600;text-transform:uppercase;color:var(--ct);letter-spacing:.02em}
.mem-i{display:flex;align-items:center;gap:12px;padding:6px 8px;border-radius:4px;cursor:pointer}.mem-i:hover{background:var(--mh)}
.mem-av{width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:600;font-size:13px;color:#fff;flex-shrink:0;position:relative}
.mem-av .sd{position:absolute;bottom:-1px;right:-1px;width:10px;height:10px;border-radius:50%;border:2.5px solid var(--bs);background:var(--gn)}
.mem-n{font-size:15px;font-weight:500;color:var(--ct)}.mem-i:hover .mem-n{color:var(--ch)}
 .mem-self-card{position:relative;min-height:82px;overflow:hidden;margin:6px 0 10px;border:1px solid rgba(255,255,255,.16);background-color:#252a35;background-size:cover;background-position:center;border-radius:9px;box-shadow:0 4px 12px rgba(0,0,0,.22)}
.mem-self-card::before{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(9,10,12,.38),rgba(9,10,12,.08)),linear-gradient(0deg,rgba(9,10,12,.34),transparent 72%)}
.mem-self-card .mem-i{position:relative;min-height:82px;z-index:1}
.mem-self-card .mem-n{color:#fff!important;text-shadow:0 1px 5px rgba(0,0,0,.95);font-weight:700}
.mem-i.has-banner{position:relative;min-height:58px;overflow:hidden;margin:5px 0;padding:7px 8px;background-color:#252a35;background-size:cover;background-position:center;border:1px solid rgba(255,255,255,.13);border-radius:8px;box-shadow:0 3px 9px rgba(0,0,0,.18)}
.mem-i.has-banner::before{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(9,10,12,.64),rgba(9,10,12,.28)),linear-gradient(0deg,rgba(9,10,12,.2),transparent)}
.mem-i.has-banner>*{position:relative;z-index:1}
.mem-i.has-banner .mem-n{color:#fff!important;text-shadow:0 1px 5px rgba(0,0,0,.95);font-weight:700}
.mem-i.has-banner:hover{filter:brightness(1.12)}
.mem-self-card .mem-i:hover{background:transparent}
.vp{background:#232428;border-top:1px solid rgba(0,0,0,.2);padding:8px;display:none;flex-shrink:0}.vp.vis{display:block}
.vp-s{display:flex;align-items:center;gap:8px;padding:4px 8px}.vp-sd{width:8px;height:8px;border-radius:50%;background:var(--gn)}.vp-st{font-size:13px;font-weight:600;color:var(--gn)}
.vp-ch{font-size:12px;color:var(--tm);padding:0 8px 4px}
.vp-b{width:calc(100% - 16px);height:32px;border-radius:4px;display:flex;align-items:center;justify-content:center;background:var(--mh);color:var(--rd);margin:4px 8px}.vp-b:hover{background:rgba(242,63,67,.1)}
.vp-video-btn{height:32px;padding:0 10px;border-radius:5px;background:rgba(104,117,255,.14);color:#9ba5ff;font-size:12px;font-weight:700;margin:4px 8px}.vp-video-btn:hover,.vp-video-btn.on{background:var(--br);color:#fff}
.video-room{display:none;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px;padding:14px;background:#111317;border-bottom:1px solid #252830;max-height:260px;overflow-y:auto;flex-shrink:0}
.video-room.vis{display:grid}
.video-tile{position:relative;min-height:150px;border-radius:12px;background:linear-gradient(145deg,#222733,#101216);border:1px solid #292d35;display:flex;align-items:center;justify-content:center;overflow:hidden}
.video-tile video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;background:#101216}
.video-tile video[hidden]{display:none}
.video-tile-name{position:absolute;left:10px;bottom:9px;z-index:3;padding:3px 8px;border-radius:12px;background:rgba(0,0,0,.62);color:#fff;font-size:12px;font-weight:600;max-width:calc(100% - 20px);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.video-avatar-wrap{position:relative;z-index:2;width:68px;height:68px;border-radius:50%;padding:4px;background:#17191e;box-shadow:0 4px 16px #0008;transition:transform .15s}
.video-avatar{width:100%;height:100%;border-radius:50%;display:flex;align-items:center;justify-content:center;overflow:hidden;background-size:cover;background-position:center;color:#fff;font-size:24px;font-weight:700;border:2px solid rgba(255,255,255,.22)}
.video-avatar.speaking{border-color:#38a7ff;animation:voiceRing .8s ease-in-out infinite;box-shadow:0 0 0 3px #168bff,0 0 18px #168bffb8}
@keyframes voiceRing{0%,100%{transform:scale(1);box-shadow:0 0 0 2px #168bff,0 0 10px #168bff88}50%{transform:scale(1.08);box-shadow:0 0 0 6px #168bff,0 0 22px #168bffcc}}
@media(prefers-reduced-motion:reduce){.video-avatar.speaking{animation:none}}
.modal-o{position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:100;display:flex;align-items:center;justify-content:center}
.modal-o.hide{display:none}
.modal{background:var(--bp);border-radius:8px;padding:32px;max-width:440px;width:90%;box-shadow:0 8px 24px rgba(0,0,0,.4);position:relative}
.modal h2{text-align:center;font-size:24px;font-weight:700;color:var(--hp);margin-bottom:8px}
.modal p{text-align:center;font-size:14px;color:var(--tm);margin-bottom:20px;line-height:1.5}
.modal label{display:block;font-size:12px;font-weight:700;text-transform:uppercase;color:var(--hs);margin-bottom:8px;letter-spacing:.02em}
.modal input[type="text"]{width:100%;padding:10px;background:var(--ib);border-radius:4px;font-size:16px;margin-bottom:16px;border:1px solid var(--bt)}.modal input[type="text"]:focus{border-color:var(--br)}
.mbtn{width:100%;padding:12px;background:var(--br);color:#fff;border-radius:4px;font-size:16px;font-weight:500;cursor:pointer;border:none;transition:background .17s}.mbtn:hover{background:var(--bd)}
.mbtn.sec{background:var(--bs);color:var(--tn);margin-top:8px}.mbtn.sec:hover{background:var(--mh)}
.modal-close{position:absolute;top:12px;right:12px;width:28px;height:28px;display:flex;align-items:center;justify-content:center;color:var(--tm);cursor:pointer;font-size:20px;border-radius:4px}.modal-close:hover{color:var(--ch)}
.add-srv-opts{display:flex;flex-direction:column;gap:8px;margin-bottom:16px}
.add-srv-opt{display:flex;align-items:center;gap:12px;padding:12px;background:var(--bs);border-radius:8px;cursor:pointer;border:2px solid transparent;transition:border .15s}
.add-srv-opt:hover{border-color:var(--br)}
.add-srv-opt.sel{border-color:var(--br);background:rgba(88,101,242,.1)}
.add-srv-opt-icon{width:48px;height:48px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0}
.add-srv-opt-text{flex:1}
.add-srv-opt-title{font-weight:600;color:var(--hp);font-size:15px}.add-srv-opt-desc{font-size:12px;color:var(--tm);margin-top:2px}
.emoji-picker{position:absolute;bottom:52px;right:0;width:352px;background:var(--bt);border-radius:8px;box-shadow:0 8px 24px rgba(0,0,0,.4);z-index:50;display:none;flex-direction:column;overflow:hidden}
.emoji-picker.vis{display:flex}
.emoji-picker-search{padding:8px}
.emoji-picker-search input{width:100%;padding:6px 8px;background:var(--bp);border-radius:4px;font-size:14px;color:var(--tn);border:none}
.emoji-picker-search input::placeholder{color:var(--tm)}
.emoji-cats{display:flex;gap:2px;padding:0 8px 4px;border-bottom:1px solid var(--sep)}
.emoji-cat-btn{padding:4px 6px;border-radius:4px;font-size:18px;cursor:pointer;opacity:.5;transition:opacity .15s}
.emoji-cat-btn:hover,.emoji-cat-btn.on{opacity:1;background:var(--mh)}
.emoji-grid{display:grid;grid-template-columns:repeat(8,1fr);gap:2px;padding:8px;overflow-y:auto;max-height:280px}
.emoji-cell{width:100%;aspect-ratio:1;display:flex;align-items:center;justify-content:center;font-size:24px;cursor:pointer;border-radius:4px;transition:background .1s}
.emoji-cell:hover{background:var(--mh)}
.emoji-cat-label{grid-column:1/-1;font-size:12px;font-weight:700;text-transform:uppercase;color:var(--tm);padding:4px 2px;letter-spacing:.02em}
.lightbox{position:fixed;inset:0;background:rgba(0,0,0,.85);z-index:200;display:none;align-items:center;justify-content:center;cursor:pointer}
.lightbox.vis{display:flex}
.lightbox img{max-width:90vw;max-height:90vh;border-radius:4px}
.cst{position:fixed;top:0;left:0;right:0;padding:6px;text-align:center;font-size:13px;font-weight:600;z-index:200;display:none;transition:opacity .5s}.cst.con{display:block;background:var(--yl);color:#000}.cst.ok{display:block;background:var(--gn);color:#fff}
.msg-toast{position:fixed;top:16px;right:16px;background:var(--bs);border:1px solid var(--sep);border-radius:8px;padding:10px 14px;max-width:300px;z-index:500;box-shadow:0 4px 16px rgba(0,0,0,.5);cursor:pointer;display:none;animation:toastIn .2s ease}
.msg-toast.vis{display:block}
@keyframes toastIn{from{opacity:0;transform:translateX(20px)}to{opacity:1;transform:translateX(0)}}
.msg-toast-srv{font-size:11px;font-weight:700;text-transform:uppercase;color:var(--br);letter-spacing:.04em;margin-bottom:3px}
.msg-toast-row{display:flex;align-items:center;gap:8px}
.msg-toast-av{width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:#fff;flex-shrink:0;background-size:cover;background-position:center}
.msg-toast-body{flex:1;min-width:0}
.msg-toast-name{font-size:13px;font-weight:600;color:var(--hp);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
